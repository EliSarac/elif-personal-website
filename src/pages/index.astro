---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Hi, I'm Elif <span class="text-xl">👋🏻</span>
    </h4>
    <div class="mt-4">
      <img src="/elif.jpeg" class="w-full sm:w-1/2" alt="Elif Saracoglu" />
    </div>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">I'm Elif, a passionate language enthusiast and Data Scientist 🪐</p>
          <p class="animate">
            I currently work in Research & Development, where I'm involved in a variety of projects across different areas of data science and AI. My work is diverse and constantly evolving, allowing me to explore new challenges and apply cutting-edge technologies for industry applications.
          </p>
          <p class="animate">
            My journey into data science began with a Master's in Cognitive Science, where I focused on computational modeling of language and cognition. That interdisciplinary research, combining linguistics, cognitive neuroscience, and computer science, gave me a deep appreciation for how the brain works and how we can model it computationally. While my current work spans broader domains, I remain passionate about language technologies and LLMs.
          </p>
          <p class="animate">
            Besides work, I'm a nature lover! You'll often find me hiking in the mountains or enjoying water sports at the beach. In my free time, I love to read and write about both technical and non-technical topics in cognitive neuroscience, psychology, linguistics and beyond. Feel free to explore my blog entries here to dive deeper into my thoughts and projects.
          </p>
          <p class="animate">Currently based in beautiful Italy 🇮🇹 🏔️</p>
          <p class="animate">
            <strong>Stay connected!</strong> I'm always inspired to meet fellow enthusiasts and collaborate on exciting ideas. Let's connect on <Link href="https://www.linkedin.com/in/saracoglu-elif/" external>LinkedIn</Link>!
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Latest posts</h5>
          <Link href="/blog"> See all posts </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">Let's Connect</h5>
        <ul class="flex flex-wrap gap-2">
          {
            SOCIALS.map((SOCIAL) => (
              <li class="flex gap-x-2 text-nowrap">
                <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                  {SOCIAL.NAME}
                </Link>
                {"/"}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>